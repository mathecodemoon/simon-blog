---
import { generateToc } from '../../utils/generateToc';
import type { MarkdownHeading } from 'astro';
import TOCHeading from './TOCHeading.astro';

interface Props {
  title: MarkdownHeading;
  headings: MarkdownHeading[];
}

const { headings, title } = Astro.props;

const toc = generateToc([title, ...headings]);
---

<aside class='sticky top-20 order-2 -me-32 hidden basis-64 lg:block'>
  <h2 class='title text-lg'>Table of Contents</h2>
  <div class='mt-4 flex gap-3'>
    <div class='scroll-progress w-1 shrink-0'>
      <div class='scroll-progress-bar w-full'></div>
    </div>
    <nav
      aria-label='Table of contents'
      class='toc max-h-[calc(100vh-11rem)] overflow-y-auto pb-8'
    >
      {toc.map((heading) => <TOCHeading heading={heading} />)}
    </nav>
  </div>
</aside>

<script client:load>
	document.addEventListener('DOMContentLoaded', () => {
		const aside = document.querySelector('aside');
		const tocBox = document.querySelector('.toc');
		const tocLinks = document.querySelectorAll('.toc a');
		if (tocLinks.length === 0) return;

		// Map each TOC link to its target heading element.
		const linkBySlug = new Map();
		tocLinks.forEach((link) => {
			linkBySlug.set(link.getAttribute('href').slice(1), link);
		});

		const setActive = (link) => {
			tocLinks.forEach((l) => l.removeAttribute('data-active'));
			if (!link) return;
			link.setAttribute('data-active', 'true');
			// Keep the active entry visible inside the sticky TOC box,
			// animating the box's own scroll (never the page).
			const boxTop = tocBox.getBoundingClientRect().top;
			const linkTop = link.getBoundingClientRect().top;
			const boxHeight = tocBox.clientHeight;
			const linkHeight = link.offsetHeight;
			if (linkTop < boxTop) {
				tocBox.scrollTo({ top: tocBox.scrollTop - (boxTop - linkTop), behavior: 'smooth' });
			} else if (linkTop + linkHeight > boxTop + boxHeight) {
				tocBox.scrollTo({
					top: tocBox.scrollTop + (linkTop + linkHeight - (boxTop + boxHeight)),
					behavior: 'smooth',
				});
			}
		};

		// Click: jump to the section and mark it active immediately.
		tocLinks.forEach((link) => {
			link.addEventListener('click', () => setActive(link));
		});

		const article = document.querySelector('article[data-pagefind-body]') || document.body;
		const scrollBar = document.querySelector('.scroll-progress-bar');

		const onScroll = () => {
			// Scroll-spy: the active section is the last heading whose top sits
			// at or above a line placed in the upper part of the viewport, so
			// the highlight tracks what is being read without lagging a full
			// screen behind.
			const line = window.innerHeight * 0.35;
			const els = [...linkBySlug.keys()]
				.map((slug) => document.getElementById(slug))
				.filter(Boolean);
			let current = null;
			for (const el of els) {
				if (el.getBoundingClientRect().top <= line) current = el;
				else break;
			}
			setActive(current ? linkBySlug.get(current.id) : null);

			// Progress bar relative to the article content, not the whole page.
			const rect = article.getBoundingClientRect();
			const total = rect.height - window.innerHeight;
			const progress = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 0;
			scrollBar.style.height = progress * 100 + '%';
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	});
</script>
